# Use a long random value (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))").
DW_SECRET_KEY=REPLACE_WITH_48_BYTE_RANDOM_SECRET
# Generate with: python -m server.hash_password (run locally and store only in private .env)
DW_ADMIN_USERNAME=admin
DW_ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_PBKDF2_HASH
# Enable only after domain, TLS, administrator credentials and storage are verified.
DW_APPLICATIONS_OPEN=0
DW_SECURE_COOKIES=1

# Canonical public hostname for this project; update only if domain strategy changes.
# DNS A record designweek.nass.life must point to the existing VPS IPv4 before TLS is issued.
DW_ALLOWED_HOSTS=designweek.nass.life