# Dedicated, HTTP-only bootstrap vhost for designweek.nass.life.
# Does NOT modify nginx.conf or any existing server block.
# Install only after reviewing existing Nginx services, DNS ownership, and port 80.
# Obtain a certificate and enable HTTPS immediately after DNS points at the verified VPS.
# Keep DW_APPLICATIONS_OPEN=0 until TLS, admin authentication and upload privacy are tested.

server {
    listen 80;
    listen [::]:80;
    server_name designweek.nass.life;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8926;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
